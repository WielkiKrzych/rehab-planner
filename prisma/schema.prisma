// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String?
  role          String    @default("physio") // admin, physio
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("users")
}

model Patient {
  id            String       @id @default(cuid())
  firstName     String
  lastName      String
  birthDate     String
  phone         String?
  email         String?
  notes         String       @default("")
  activePlanId  String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  
  diagnoses     Diagnosis[]
  plans         Plan[]
  dailyCheckins DailyCheckin[]
  goals         PatientGoal[]
  chatMessages  ChatMessage[]
  progressReports ProgressReport[]
  
  @@index([firstName, lastName])
  @@index([email])
  @@index([updatedAt])
  @@map("patients")
}

model Diagnosis {
  id          String   @id @default(cuid())
  name        String
  date        String
  notes       String?
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  
  @@index([patientId])
  @@map("diagnoses")
}

model Plan {
  id          String      @id @default(cuid())
  name        String
  description String?
  patientId   String?
  status      String      @default("template")
  createdAt   DateTime    @default(now())
  
  patient     Patient?    @relation(fields: [patientId], references: [id], onDelete: SetNull)
  weeks       PlanWeek[]
  
  @@index([patientId])
  @@index([status])
  @@index([createdAt])
  @@map("plans")
}

model PlanWeek {
  id          String      @id @default(cuid())
  weekNumber  Int
  focus       String?
  planId      String
  plan        Plan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  days        PlanDay[]
  
  @@map("plan_weeks")
}

model PlanDay {
  id          String          @id @default(cuid())
  dayNumber   Int
  notes       String?
  weekId      String
  week        PlanWeek        @relation(fields: [weekId], references: [id], onDelete: Cascade)
  exercises   PlanExercise[]
  
  @@map("plan_days")
}

model PlanExercise {
  id          String   @id @default(cuid())
  exerciseId  String
  sets        Int      @default(3)
  reps        Int      @default(10)
  holdSeconds Int?
  notes       String?
  dayId       String
  day         PlanDay  @relation(fields: [dayId], references: [id], onDelete: Cascade)
  
  @@map("plan_exercises")
}

model Exercise {
  id          String   @id @default(cuid())
  name        String
  description String
  category    String
  bodyPart    String
  difficulty  Int
  duration    Int?
  reps        Int?
  sets        Int?
  equipment   String   @default("")
  imageUrl    String?
  tags        String   @default("")
  isDefault   Boolean  @default(false)
  
  @@index([category])
  @@index([bodyPart])
  @@index([name])
  @@map("exercises")
}

model DailyCheckin {
  id            String    @id @default(cuid())
  patientId     String
  patient       Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  date          String
  painLevel     Int       @default(0)
  energyLevel   Int       @default(5)
  sleepQuality  Int       @default(5)
  mood          Int       @default(5)
  notes         String    @default("")
  aiRecommendation String @default("")
  status        String    @default("pending")
  createdAt     DateTime  @default(now())
  
  @@index([patientId])
  @@index([date])
  @@map("daily_checkins")
}

model PatientGoal {
  id          String    @id @default(cuid())
  patientId   String
  patient     Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  name        String
  description String?
  goalType    String
  targetDate  String?
  status      String    @default("active")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@index([patientId])
  @@map("patient_goals")
}

model ChatMessage {
  id          String    @id @default(cuid())
  patientId   String
  patient     Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  role        String
  content     String
  createdAt   DateTime  @default(now())
  
  @@index([patientId])
  @@map("chat_messages")
}

model ProgressReport {
  id          String    @id @default(cuid())
  patientId   String
  patient     Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  weekStart   String
  weekEnd     String
  summary     String
  aiAnalysis  String?
  createdAt   DateTime  @default(now())
  
  @@index([patientId])
  @@index([weekStart])
  @@map("progress_reports")
}
